# Cache y skill registry del harness gentle-ai. Se regeneran solos y no son
# parte de las soluciones, así que no van al repo.
/.atl/

# Documentos de trabajo ODD (task files). Mismo criterio: tracking del proceso,
# no parte de las soluciones.
/odd/

# Octave escribe esto al salir de una sesión interactiva.
.octave_hist

# Bytecode de Python de las herramientas de informe.
__pycache__/
*.pyc

# Octave guarda esto al recibir SIGTERM en una corrida interactiva.
octave-workspace

# Copia temporal de principal.m sin waitfor (la genera capturas.py).
_principal_captura.m

# Entorno Python de las herramientas de informe.
herramientas/informe/.venv/

# Artefactos generados del informe del TP.
tp-evaluativo-1-metodos-de-raices/informe/img/

# Archivo de bloqueo de LibreOffice mientras el .docx está abierto.
.~lock.*#
